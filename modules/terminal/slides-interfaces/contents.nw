skottår.
\end{onlyin}

<<[[generate-reports.sh]]>>=
#!/bin/sh
<<function [[days_in_month]]>>

mkdir -p reports
for year in $(seq 2001 2009); do
  for month in 01 02 03 04 05 06 07 08 09 10 11 12; do
    for day in $(seq -w 1 "$(days_in_month "$year" "$month")"); do
      echo "Report for $year-$month-$day" \
        > "reports/$year-$month-$day.txt"
    done
  done
done
@

\begin{onlyin}{english} % sync english=f3e3f2 swedish=78dcfa
A year is a leap year if it is divisible by four, except a year
divisible by 100 that is not divisible by 400:
\end{onlyin}
\begin{onlyin}{swedish}
Ett år är ett skottår om det är delbart med fyra, utom ett år som är
delbart med 100 men inte med 400:
\end{onlyin}

<<function [[days_in_month]]>>=
days_in_month() {
  case $2 in
    04 | 06 | 09 | 11) echo 30 ;;
    02)
      if [ $((($1 % 4 == 0 && $1 % 100 != 0) || $1 % 400 == 0)) -eq 1 ]
      then echo 29
      else echo 28
      fi
      ;;
    *) echo 31 ;;
  esac
}
@

