\decksection{\ensv{GUI and CLI}{GUI och CLI}}% % sync english=838973 swedish=ffac87
  {\ensv{One task, two user interfaces}%
    {En uppgift, två användargränssnitt}} % sync english=1766ed swedish=fdd1f2
\mode*
\label{sec:gui-cli}

\begin{onlyin}{english} % sync english=c1ffa2 swedish=ae6764
\leavevmode\ltnote{%
  Relevant learning objective: \cref{InterfacesLOKinds}.

