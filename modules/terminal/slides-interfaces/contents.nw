% The notes show the program whole, as one chunk; the slides, where it
% does not fit on one frame, show the tangled file in two parts on
% presentation-only frames.
\begin{example}[\ensv{A program that lists in columns}%
  {Ett program som listar i kolumner}] % sync english=2bbe2e swedish=9e0438
  \label{ex:ls-py}
\begin{onlyin}{english} % sync english=097d90 swedish=766f31
The program [[ls.py]] prints the names in columns:
\end{onlyin}
\begin{onlyin}{swedish}
Programmet [[ls.py]] skriver ut namnen i kolumner:
\end{onlyin}
<<[[ls.py]]>>=
import os
import shutil

def main():
    names = filter(lambda x: x[0] != ".", os.listdir("."))
    filenames = sorted(names)
    max_width_filename = max(map(len, filenames))
    screen_width = shutil.get_terminal_size((80, 20)).columns
    files_per_line = screen_width // (max_width_filename + 2)

    for number, filename in enumerate(filenames, start=1):
        print(f" {filename:{max_width_filename}s} ", end="")
        if number % files_per_line == 0:
            print()
    if len(filenames) % files_per_line != 0:
        print()

if __name__ == "__main__":
    main()
@
\end{example}

